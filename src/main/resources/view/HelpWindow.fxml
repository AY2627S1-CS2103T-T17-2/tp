<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root title="Command guide" minWidth="480.0" minHeight="320.0" type="javafx.stage.Stage"
    xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="760.0" prefHeight="640.0">
        <content>
          <VBox spacing="20.0" styleClass="help-content">
            <VBox spacing="8.0">
              <Label text="Command guide" styleClass="help-title" />
              <Label text="All 10 commands, with syntax and examples. Type a command and press Enter."
                  wrapText="true" styleClass="help-subtitle" />
            </VBox>
            <VBox spacing="6.0" styleClass="help-notes">
              <Label text="Reading the syntax" styleClass="field-heading" />
              <Label text="CAPITALS are values you supply. [Brackets] mark optional fields. ... means a field can repeat."
                  wrapText="true" styleClass="command-description" />
              <Label text="INDEX is the positive number beside an athlete in the current list."
                  wrapText="true" styleClass="command-description" />
            </VBox>
            <VBox fx:id="commandList" spacing="14.0" />
          </VBox>
        </content>
      </ScrollPane>
    </Scene>
  </scene>
</fx:root>
