<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<fx:root type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
         title="TrackFlow" minWidth="450" minHeight="600" onCloseRequest="#handleExit">
  <icons>
    <Image url="@/images/trackflow_32.png" />
    <Image url="@/images/trackflow_256.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@DarkTheme.css" />
        <URL value="@Extensions.css" />
      </stylesheets>

      <VBox>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" VBox.vgrow="NEVER">
          <MenuBar fx:id="menuBar" HBox.hgrow="ALWAYS">
            <Menu mnemonicParsing="false" text="File">
              <MenuItem mnemonicParsing="false" onAction="#handleExit" text="Exit" />
            </Menu>
          </MenuBar>
          <HBox styleClass="brand" alignment="CENTER" spacing="7" fillHeight="false">
            <Group>
              <SVGPath styleClass="brand-lane" content="M2 12.67c0-4.67 3-8.67 8-8.67h4" />
              <SVGPath styleClass="brand-lane, brand-lane-mid" content="M5.33 12.67c0-2.67 1.67-5.33 4.67-5.33h4" />
              <SVGPath styleClass="brand-lane, brand-lane-inner" content="M8.67 12.67c0-1.07 0.67-2 1.67-2h3.67" />
            </Group>
            <HBox alignment="CENTER_LEFT">
              <Label text="Track" styleClass="brand-label" />
              <Label text="Flow" styleClass="brand-label, brand-label-accent" />
            </HBox>
          </HBox>
        </HBox>

        <StackPane VBox.vgrow="NEVER" fx:id="commandBoxPlaceholder" styleClass="pane-with-border">
          <padding>
            <Insets top="12" right="14" bottom="8" left="14" />
          </padding>
          <!-- Drawn above the command box (viewOrder) and ignores the mouse, so typing is unaffected. -->
          <Label text="›" styleClass="command-prompt" mouseTransparent="true" viewOrder="-1"
                 StackPane.alignment="CENTER_LEFT">
            <StackPane.margin>
              <Insets left="14" />
            </StackPane.margin>
          </Label>
        </StackPane>

        <StackPane VBox.vgrow="NEVER" fx:id="resultDisplayPlaceholder" styleClass="pane-with-border"
                   minHeight="100" prefHeight="100" maxHeight="100">
          <padding>
            <Insets top="0" right="14" bottom="4" left="14" />
          </padding>
        </StackPane>

        <VBox fx:id="personList" styleClass="pane-with-border" minWidth="340" prefWidth="340" VBox.vgrow="ALWAYS">
          <padding>
            <Insets top="8" right="14" bottom="12" left="14" />
          </padding>
          <Label text="ROSTER" styleClass="section-label" />
          <StackPane fx:id="personListPanelPlaceholder" VBox.vgrow="ALWAYS"/>
        </VBox>

        <StackPane fx:id="statusbarPlaceholder" VBox.vgrow="NEVER" />
      </VBox>
    </Scene>
  </scene>
</fx:root>
