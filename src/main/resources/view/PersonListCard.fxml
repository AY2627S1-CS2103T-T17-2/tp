<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<GridPane id="cardPane" fx:id="cardPane" hgap="12" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <columnConstraints>
    <ColumnConstraints minWidth="-Infinity" />
    <!-- The details column takes the remaining width; GridPane measures wrapped text at that width. -->
    <ColumnConstraints hgrow="ALWAYS" minWidth="0" prefWidth="150" />
    <ColumnConstraints minWidth="-Infinity" />
  </columnConstraints>
  <padding>
    <Insets top="10" right="16" bottom="10" left="13" />
  </padding>
  <Label fx:id="id" styleClass="cell_index" GridPane.columnIndex="0" GridPane.valignment="TOP">
    <minWidth>
      <!-- Ensures that the label text is never truncated -->
      <Region fx:constant="USE_PREF_SIZE" />
    </minWidth>
  </Label>
  <VBox spacing="3" minWidth="0" GridPane.columnIndex="1">
    <Label fx:id="name" text="\$first" styleClass="cell_big_label" wrapText="true" />
    <!-- A TextFlow (unlike a Label) can break a long email address that has no spaces. -->
    <TextFlow>
      <Text fx:id="phone" styleClass="cell_detail, cell_phone" text="\$phone" />
      <Text text="  ·  " styleClass="cell_detail, cell_separator" />
      <Text fx:id="email" styleClass="cell_detail" text="\$email" />
    </TextFlow>
    <Label fx:id="address" styleClass="cell_small_label" text="\$address" wrapText="true" />
    <FlowPane fx:id="tags" />
    <Label fx:id="remark" styleClass="cell_small_label, cell_remark" text="\$remark" wrapText="true" />
  </VBox>
  <Label fx:id="ageCategory" styleClass="age-pill" GridPane.columnIndex="2" GridPane.valignment="TOP">
    <minWidth>
      <Region fx:constant="USE_PREF_SIZE" />
    </minWidth>
  </Label>
</GridPane>
