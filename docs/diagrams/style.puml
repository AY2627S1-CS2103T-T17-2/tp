/'
 'Shared presentation for TrackFlow diagrams.
 'Keep class relationships and feature-specific notes in the individual diagrams.
 'Full style guide, notation, layout, and PR checklist:
 '../Documentation.md#uml-diagram-conventions
 'Course reference: https://nus-cs2103-ay2627-s1.github.io/website/admin/uml-reference-sheet.html
 'Use base component colours for classes and participants, and T1 shades for interfaces.
 'Keep relationship notation, layout hints, and scenario-specific notes in each diagram.
 'After a shared style change, build the docs and inspect all affected diagrams.
 '/


'T1 through T4 are shades of the original color from lightest to darkest

!define UI_COLOR #1D8900
!define UI_COLOR_T1 #83E769
!define UI_COLOR_T2 #3FC71B
!define UI_COLOR_T3 #166800
!define UI_COLOR_T4 #0E4100

!define LOGIC_COLOR #3333C4
!define LOGIC_COLOR_T1 #C8C8FA
!define LOGIC_COLOR_T2 #6A6ADC
!define LOGIC_COLOR_T3 #1616B0
!define LOGIC_COLOR_T4 #101086

!define MODEL_COLOR #9D0012
!define MODEL_COLOR_T1 #F97181
!define MODEL_COLOR_T2 #E41F36
!define MODEL_COLOR_T3 #7B000E
!define MODEL_COLOR_T4 #51000A

!define STORAGE_COLOR #A38300
!define STORAGE_COLOR_T1 #FFE374
!define STORAGE_COLOR_T2 #EDC520
!define STORAGE_COLOR_T3 #806600
!define STORAGE_COLOR_T4 #544400

!define USER_COLOR #000000

skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowThickness 1.1
skinparam ArrowFontColor #334155
skinparam NoteBackgroundColor #F8FAFC
skinparam NoteBorderColor #CBD5E1
skinparam NoteFontColor #1E293B
skinparam NoteFontSize 13
skinparam ClassAttributeFontColor #FFFFFF
skinparam ClassAttributeIconSize 0

'Explicit <<interface>> classifiers use the component's T1 shade.
'Dark text and borders also keep generic parameter boxes readable.
skinparam ClassFontColor<<interface>> #1E293B
skinparam ClassAttributeFontColor<<interface>> #1E293B
skinparam ClassStereotypeFontColor<<interface>> #1E293B
skinparam ClassBorderColor<<interface>> #64748B

skinparam Package {
    BackgroundColor #FFFFFF
    BorderThickness 1
    FontSize 16
}

skinparam Class {
    FontColor #FFFFFF
    FontSize 15
    BorderThickness 1
    BorderColor #FFFFFF
    StereotypeFontColor #FFFFFF
    FontName Arial
}

skinparam Actor {
    BorderColor USER_COLOR
    Color USER_COLOR
    FontName Arial
    FontColor #1E293B
}

skinparam Sequence {
    MessageAlign center
    BoxFontSize 15
    BoxPadding 0
    BoxFontColor #FFFFFF
    FontName Arial
    ArrowFontColor #334155
    LifeLineBorderColor #64748B
}

skinparam Participant {
    FontColor #FFFFFF
    Padding 20
}

skinparam ArrowFontStyle bold
skinparam MinClassWidth 50
skinparam ParticipantPadding 10
skinparam Shadowing false
skinparam DefaultTextAlignment center
skinparam packageStyle Rectangle

hide footbox
hide members
hide circle
