@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam linetype polyline
skinparam arrowColor MODEL_COLOR_T4
skinparam classBackgroundColor MODEL_COLOR
interface ReadOnlyRoster <<interface>> MODEL_COLOR_T1 {
  +getPersonList(): ObservableList<Person>
}
show ReadOnlyRoster members
class AthleteRoster
class UniquePersonList
class Person
class Name
class AgeCategory
class Phone
class Email
class Address
class Remark
class Tag
AthleteRoster .up.|> ReadOnlyRoster
AthleteRoster *-right-> "1" UniquePersonList : persons
UniquePersonList -right-> "0..*" Person : internalList {ordered}
Person --> "1" Name
Person --> "1" AgeCategory
Person --> "1" Phone
Person --> "1" Email
Person --> "1" Address
Person --> "1" Remark
Person --> "0..*" Tag : tags {unique}
Name -[hidden]right- AgeCategory
AgeCategory -[hidden]right- Phone
Email -[hidden]right- Address
Address -[hidden]right- Remark
legend bottom
  Stored athlete fields; immutable value objects may be shared between Person instances.
  ReadOnlyRoster exposes an unmodifiable observable list; JavaFX collection classes are omitted.
  UniquePersonList enforces athlete identity using Person.isSamePerson.
  Each Tag represents an event managed by tag/untag.
  Tag equality ignores case; display preserves the stored spelling.
endlegend
@enduml
