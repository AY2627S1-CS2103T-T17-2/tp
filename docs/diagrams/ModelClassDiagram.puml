@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam linetype polyline
skinparam arrowColor MODEL_COLOR_T4
skinparam classBackgroundColor MODEL_COLOR
package "Model" as ModelPackage {
    interface Model <<interface>> MODEL_COLOR_T1
    interface ReadOnlyRoster <<interface>> MODEL_COLOR_T1
    interface ReadOnlyUserPrefs <<interface>> MODEL_COLOR_T1
    class ModelManager
    class AthleteRoster
    class UserPrefs
    class UniquePersonList
    class Person
}
package "JavaFX views" {
    class FilteredList MODEL_COLOR_T2
    class SortedList MODEL_COLOR_T2
}
ModelManager .up.|> Model
AthleteRoster .up.|> ReadOnlyRoster
UserPrefs .up.|> ReadOnlyUserPrefs
ModelManager *--> "1" AthleteRoster
ModelManager *--> "1" UserPrefs
AthleteRoster *--> "1" UniquePersonList
UniquePersonList --> "*" Person
ModelManager --> "1" FilteredList
ModelManager --> "1" SortedList
SortedList --> "1" FilteredList : source
legend bottom
  Partial view. JavaFX lists contain Person; generic parameters are omitted.
  FilteredList observes UniquePersonList's observable list, not the wrapper object.
  getFilteredPersonList() exposes SortedList, preserving displayed index order.
endlegend
@enduml
