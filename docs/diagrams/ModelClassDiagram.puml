@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

package Model {
    interface Model
    interface ReadOnlyRoster
    interface ReadOnlyUserPrefs
    class ModelManager
    class AthleteRoster
    class UserPrefs
    class UniquePersonList
    class Person
}

package "JavaFX views" {
    class "FilteredList<Person>" as FilteredList
    class "SortedList<Person>" as SortedList
}

ModelManager .up.|> Model
AthleteRoster .up.|> ReadOnlyRoster
UserPrefs .up.|> ReadOnlyUserPrefs
ModelManager *--> "1" AthleteRoster
ModelManager *--> "1" UserPrefs
AthleteRoster *--> "1" UniquePersonList
UniquePersonList --> "*" Person
ModelManager --> FilteredList
ModelManager --> SortedList
SortedList --> FilteredList : wraps
FilteredList ..> UniquePersonList : views its observable list
note bottom of SortedList
  getFilteredPersonList() exposes this view.
  Indexed commands use its displayed order.
end note
@enduml
