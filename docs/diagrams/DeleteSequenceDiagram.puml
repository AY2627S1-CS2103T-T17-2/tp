@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam maxMessageSize 180

participant ":LogicManager" as logic LOGIC_COLOR
participant "command:DeleteCommand" as command LOGIC_COLOR
participant "staged:ModelManager" as staged MODEL_COLOR

activate logic LOGIC_COLOR
logic -> command : execute(staged)
activate command LOGIC_COLOR
command -> staged : getFilteredPersonList()
activate staged MODEL_COLOR
staged --> command : displayedAthletes
deactivate staged

note over command
  Select the athlete at the
  displayed index (here, 1).
end note

command -> staged : deletePerson(athleteToDelete)
activate staged MODEL_COLOR
staged --> command
deactivate staged
command --> logic : commandResult
deactivate command
deactivate logic

legend bottom
  Valid index assumed; the command and staged model already exist.
  This changes only the staged roster. LogicManager saves it afterwards.
endlegend
@enduml
