@startuml
!include style.puml
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR
skinparam ArrowFontStyle plain
skinparam linetype polyline
show members
hide empty members

package "Logic" as LogicPackage {
    interface Logic <<interface>> LOGIC_COLOR_T1 {
        +execute(commandText: String): CommandResult
    }
    class LogicManager
    class TrackFlowParser
    abstract class "{abstract}\nCommand" as Command {
        +changesRoster(): boolean
        {abstract} +execute(model: Model): CommandResult
    }
    class EditCommand
    class FindCommand
    class CommandResult {
        +withDataSaved(): CommandResult
    }
}

interface Model <<interface>> MODEL_COLOR_T1
interface Storage <<interface>> STORAGE_COLOR_T1

LogicManager .up.|> Logic
LogicManager *-left-> "1" TrackFlowParser
LogicManager -right-> "1" Storage
LogicManager -down-> "1" Model : live model
LogicManager .down.> Command : executes
TrackFlowParser .down.> Command : returns
EditCommand -up-|> Command
FindCommand -up-|> Command
Command .down.> Model : uses during execution
LogicManager .down.> CommandResult : marks saved\nafter persistence

legend bottom
  Partial view: EditCommand changes the roster; FindCommand changes the view.
  Roster changes execute on a detached model, then save before publication.
endlegend
@enduml
