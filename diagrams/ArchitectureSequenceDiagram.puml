@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam maxMessageSize 180
skinparam SequenceReferenceBackgroundColor #F8FAFC

actor Coach as coach
participant ":MainWindow" as ui UI_COLOR
participant ":LogicManager" as logic LOGIC_COLOR
participant "live:ModelManager" as live MODEL_COLOR
participant ":StorageManager" as storage STORAGE_COLOR

coach -> ui : submits "delete 1"
activate ui UI_COLOR
ui -> logic : execute("delete 1")
activate logic LOGIC_COLOR

ref over logic
  Parse command and execute delete
  on a staged model
end ref

logic -> storage : saveRoster(updatedRoster)
activate storage STORAGE_COLOR
storage --> logic
deactivate storage

logic -> live : setRoster(updatedRoster)
activate live MODEL_COLOR
live --> logic
deactivate live
logic -> live : updateFilteredPersonList(predicate)
activate live MODEL_COLOR
live --> logic
deactivate live

logic --> ui : savedResult
deactivate logic
deactivate ui

legend bottom
  Success path: save the staged change before updating the live model.
  See the delete-execution and save-failure diagrams for those details.
endlegend
@enduml
