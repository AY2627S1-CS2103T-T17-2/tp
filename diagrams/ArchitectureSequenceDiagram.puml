@startuml
!include style.puml
skinparam ArrowFontStyle plain

actor User as user USER_COLOR
participant ":UI" as ui UI_COLOR
participant ":LogicManager" as logic LOGIC_COLOR
participant "command:DeleteCommand" as command LOGIC_COLOR
participant "live:Model" as model MODEL_COLOR
participant "stagedModel:Model" as staged MODEL_COLOR
participant ":Storage" as storage STORAGE_COLOR

user -> ui : "delete 1"
ui -> logic : execute("delete 1")
activate logic LOGIC_COLOR
logic -> model : getRoster(), getUserPrefs()\ngetPersonListPredicate(), getPersonListComparator()
model --> logic : roster and display state
logic -> staged : create detached model with same state
logic -> command : execute(stagedModel)
activate command LOGIC_COLOR
command -> staged : getFilteredPersonList()
staged --> command : displayed athletes
command -> staged : deletePerson(athleteToDelete)
staged --> command : athlete removed
command --> logic : CommandResult
deactivate command
logic -> storage : saveRoster(stagedModel.getRoster())
alt save succeeds
    storage --> logic : saved
    logic -> model : setRoster(stagedModel.getRoster())\nupdateFilteredPersonList(stagedModel.getPersonListPredicate())
    note right of model: Existing sort comparator is retained.
    logic --> ui : CommandResult.withDataSaved()
    ui --> user : updated roster and confirmation
else save fails
    storage --> logic : IOException
    logic --> ui : CommandException
    ui --> user : error; live roster and display unchanged
end
deactivate logic
@enduml
