@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam linetype polyline
skinparam arrowColor STORAGE_COLOR_T4
skinparam classBackgroundColor STORAGE_COLOR
package "Storage" as StoragePackage {
    interface Storage <<interface>> STORAGE_COLOR_T1
    class StorageManager
    class JsonUserPrefsStorage
    class JsonRosterStorage
    class JsonSerializableRoster
    class JsonAdaptedPerson
    class JsonAdaptedTag
}
StorageManager .up.|> Storage
StorageManager --> "1" JsonUserPrefsStorage
StorageManager --> "1" JsonRosterStorage
JsonRosterStorage ..> JsonSerializableRoster : reads / writes
JsonSerializableRoster --> "*" JsonAdaptedPerson
JsonAdaptedPerson --> "*" JsonAdaptedTag
legend bottom
  Partial persistence view; DTOs convert stored fields to model objects.
  The JSON roster key remains "persons" for compatibility with existing files.
  File utilities and model conversion dependencies are omitted.
endlegend
@enduml
