@startuml
!include style.puml
allowmixing
skinparam ArrowFontStyle plain
skinparam linetype polyline
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR
package "TrackFlow components" {
    class UI UI_COLOR
    class Logic LOGIC_COLOR
    class Model MODEL_COLOR
    class Storage STORAGE_COLOR
    class Main #64748B
    class Commons #64748B
}
actor Coach
artifact "JSON files" as Files STORAGE_COLOR_T1
Coach ..> UI
UI ..> Logic
UI ..> Model
Logic ..> Model
Logic ..> Storage
Storage ..> Model
Storage ..> Files
Main ..> UI
Main ..> Logic
Main ..> Model
Main ..> Storage
Main -[hidden]down- Commons
legend bottom
  Conceptual component view, not individual Java classes.
  Main includes Main and MainApp; Commons supplies shared utilities.
  Utility dependencies are omitted.
endlegend
@enduml
