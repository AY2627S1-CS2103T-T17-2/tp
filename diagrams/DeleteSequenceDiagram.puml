@startuml
!include style.puml
skinparam ArrowFontStyle plain

participant ":LogicManager" as logic LOGIC_COLOR
participant ":TrackFlowParser" as parser LOGIC_COLOR
participant ":DeleteCommandParser" as deleteParser LOGIC_COLOR
participant "d:DeleteCommand" as command LOGIC_COLOR
participant "staged:Model" as model MODEL_COLOR
participant ":Storage" as storage STORAGE_COLOR
participant "live:Model" as live MODEL_COLOR

[-> logic : execute("delete 1")
activate logic
logic -> parser : parseCommand("delete 1")
activate parser
create deleteParser
parser -> deleteParser : parse(" 1")
activate deleteParser
create command
deleteParser -> command : new DeleteCommand(index)
deleteParser --> parser : d
deactivate deleteParser
destroy deleteParser
parser --> logic : d
deactivate parser
logic -> live : read roster and display state
live --> logic : snapshot
logic -> model : create detached copy
logic -> command : execute(staged)
activate command
command -> model : getFilteredPersonList()
model --> command : displayed athletes
command -> model : deletePerson(personToDelete)
command --> logic : CommandResult
deactivate command
logic -> storage : saveRoster(staged.getRoster())
alt save succeeds
    storage --> logic : saved
    logic -> live : setRoster(staged.getRoster())\nupdateFilteredPersonList(staged predicate)
    [<-- logic : result.withDataSaved()
else save fails
    storage --> logic : IOException
    [<-- logic : CommandException (live model unchanged)
end
deactivate logic
@enduml
